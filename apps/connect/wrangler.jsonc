// Local-only bb connect worker + TunnelDO configuration for this fork.
// Production and staging Cloudflare topology belongs to get-bb/bb. The inert
// account/database ids and absent routes keep this config useful for
// `wrangler dev` without naming or targeting upstream resources.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bb-connect-local",
  "main": "./src/worker.ts",
  "account_id": "00000000000000000000000000000000",
  "compatibility_date": "2026-06-11",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "observability": { "enabled": true },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TunnelDO"] }],
  "durable_objects": {
    "bindings": [{ "name": "TUNNEL_DO", "class_name": "TunnelDO" }],
  },
  "vars": { "BASE_DOMAIN": "bb.localhost" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bb-connect-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../../packages/connect-db/migrations",
    },
  ],
  "routes": [],
}
