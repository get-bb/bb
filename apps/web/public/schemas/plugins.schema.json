{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://getbb.app/schemas/plugins.schema.json",
  "title": "BB plugin collection manifest",
  "description": "An index of plugin directories in one repository.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "name", "plugins"],
  "properties": {
    "$schema": {
      "const": "https://getbb.app/schemas/plugins.schema.json"
    },
    "schemaVersion": {
      "const": 1
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "plugins": {
      "type": "array",
      "minItems": 1,
      "$comment": "Entry names must also be unique.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "source"],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "source": {
            "type": "string",
            "pattern": "^\\./(?![A-Za-z]:)(?!(?:[^/]+/)*(?:\\.|\\.\\.|\\.git)(?:/|$))[^/\\\\]+(?:/[^/\\\\]+)*$"
          }
        }
      }
    }
  }
}
