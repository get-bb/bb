// Local-only marketing/auth/dashboard Worker configuration for this fork.
// Production and staging Cloudflare topology belongs to get-bb/bb. The inert
// account/database ids and absent routes retain local Cloud development without
// naming or targeting upstream resources.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bb-web-local",
  "account_id": "00000000000000000000000000000000",
  "compatibility_date": "2026-06-11",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  "workers_dev": false,
  "observability": { "enabled": true },
  "vars": {
    "BASE_DOMAIN": "bb.localhost",
    "APP_URL": "http://bb.localhost",
    // Resend audience that /api/subscribe adds emails to ("bb users").
    // Not a secret — only the API key is.
    "RESEND_AUDIENCE_ID": "299db4ee-f3db-476d-9847-0bf4344d9c44",
  },
  "secrets": {
    "required": [
      "GITHUB_CLIENT_ID",
      "GITHUB_CLIENT_SECRET",
      "BETTER_AUTH_SECRET",
      "LANDING_POSTHOG_KEY",
      "RESEND_API_KEY",
    ],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bb-connect-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "TUNNEL_DO",
        "class_name": "TunnelDO",
        "script_name": "bb-connect-local",
      },
    ],
  },
  "r2_buckets": [
    {
      "binding": "MARKETPLACE",
      "bucket_name": "bb-marketplace-local",
    },
  ],
  "routes": [],
}
