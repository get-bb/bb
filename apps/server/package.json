{
  "name": "@bb/server",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "node ../../scripts/build-node-entry.mjs src/index.ts dist/index.js --clean-dist --external ./start-server.js --copy-dir ../../packages/db/drizzle dist/drizzle --copy-dir src/assets dist/assets && node --import tsx scripts/copy-builtin-skills.ts && node ../../scripts/build-node-entry.mjs src/start-server.ts dist/start-server.js && node ../../scripts/build-node-entry.mjs ../../packages/plugin-sdk/src/index.ts dist/plugin-sdk-runtime.js && node ../../scripts/build-node-entry.mjs src/services/plugins/zod-runtime.ts dist/zod-runtime.js",
    "start": "node dist/index.js",
    "dev": "node --conditions=source --import tsx scripts/dev-supervisor.mjs",
    "clean": "rimraf dist",
    "generate:bb-official-marketplace": "node --conditions=source --import tsx scripts/generate-bb-official-marketplace.ts",
    "typecheck": "tsrs --noEmit",
    "lint:type-aware": "oxlint -c ../../.oxlintrc.type-aware.json",
    "validate:marketplace": "tsx scripts/validate-live-marketplace.ts",
    "test": "vitest run --config vitest.config.ts",
    "test:provider-corpus": "vitest run --config vitest.config.ts test/provider-corpus"
  },
  "dependencies": {
    "@bb/async-cache": "workspace:*",
    "@bb/config": "workspace:*",
    "@bb/core-ui": "workspace:*",
    "@bb/db": "workspace:*",
    "@bb/domain": "workspace:*",
    "@bb/file-transfer": "workspace:*",
    "@bb/host-daemon-contract": "workspace:*",
    "@bb/logger": "workspace:*",
    "@bb/plugin-build": "workspace:*",
    "@bb/process-utils": "workspace:*",
    "@bb/sdk": "workspace:*",
    "@bb/secret-storage": "workspace:*",
    "@bb/server-archive": "workspace:*",
    "@bb/server-contract": "workspace:*",
    "@bb/skill-index": "workspace:*",
    "@bb/templates": "workspace:*",
    "@bb/text-utils": "workspace:*",
    "@bb/thread-view": "workspace:*",
    "@better-auth/api-key": "^1.7.18",
    "@better-auth/drizzle-adapter": "^1.7.18",
    "@get-bb/plugin-sdk": "workspace:*",
    "@hono/node-server": "^1.19.18",
    "@hono/node-ws": "^1.3.1",
    "@opentelemetry/api": "1.10.0",
    "bb-plugin-bb--git": "workspace:*",
    "better-auth": "^1.7.18",
    "better-sqlite3": "12.11.1",
    "cron-parser": "^5.10.3",
    "drizzle-orm": "^0.45.4",
    "gray-matter": "^4.0.3",
    "hono": "^4.13.16",
    "mime-types": "^3.0.2",
    "npm": "11.21.2",
    "pino": "^9.14.0",
    "pino-pretty": "^13.2.0",
    "pino-roll": "^4.0.0",
    "semver": "^7.8.6",
    "ws": "^8.22.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@bb/agent-runtime": "workspace:*",
    "@bb/client-core": "workspace:*",
    "@bb/frp-client": "workspace:*",
    "@bb/scripts": "workspace:*",
    "@bb/test-helpers": "workspace:*",
    "@bb/tsconfig": "workspace:*",
    "@bb/tunnel-client": "workspace:*",
    "@bb/tunnel-contract": "workspace:*",
    "@types/better-sqlite3": "^7.6.13",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^22.20.5",
    "@types/semver": "^7.8.0",
    "@types/ws": "^8.18.2",
    "ajv": "8.20.0",
    "bb-plugin-bb--connect-next": "workspace:*",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
