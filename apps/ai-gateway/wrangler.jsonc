{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bb-ai-gateway",
  "main": "./src/worker.ts",
  "account_id": "7bb84c630057dafa53e2aacbe6bd094f",
  "compatibility_date": "2026-06-11",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": false,
  "observability": { "enabled": true },
  "vars": {
    "AI_DAILY_BUDGET_MICROS": "500000",
    "AI_MODELS": "google/gemini-3.1-flash-lite,inception/mercury-2.5",
    "AI_TRANSCRIBE_MODELS": "microsoft/mai-transcribe-2,openai/whisper-large-v3-turbo",
    "AI_UPSTREAM_BASE_URL": "https://openrouter.ai/api/v1",
  },
  "secrets": { "required": ["OPENROUTER_API_KEY"] },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "1645c9edadb74b8cb593218030fac7f2",
      "localConnectionString": "postgresql://bb:bb@localhost:5432/bb_connect",
    },
  ],
  "ratelimits": [
    {
      "name": "AI_RATE_LIMITER",
      "namespace_id": "4201",
      "simple": { "limit": 60, "period": 60 },
    },
  ],
  "triggers": { "crons": ["17 3 * * *"] },
  "routes": [{ "pattern": "getbb.app/api/ai/*", "zone_name": "getbb.app" }],
  "env": {
    "staging": {
      "workers_dev": false,
      "vars": {
        "AI_DAILY_BUDGET_MICROS": "500000",
        "AI_MODELS": "google/gemini-3.1-flash-lite,inception/mercury-2.5",
        "AI_TRANSCRIBE_MODELS": "microsoft/mai-transcribe-2,openai/whisper-large-v3-turbo",
        "AI_UPSTREAM_BASE_URL": "https://openrouter.ai/api/v1",
      },
      "secrets": { "required": ["OPENROUTER_API_KEY"] },
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "c4123f16fa6d4ef084d4531996012f1b",
          "localConnectionString": "postgresql://bb:bb@localhost:5432/bb_connect",
        },
      ],
      "ratelimits": [
        {
          "name": "AI_RATE_LIMITER",
          "namespace_id": "4202",
          "simple": { "limit": 60, "period": 60 },
        },
      ],
      "triggers": { "crons": ["17 3 * * *"] },
      "routes": [
        {
          "pattern": "vibecodethis.site/api/ai/*",
          "zone_name": "vibecodethis.site",
        },
      ],
    },
  },
}
