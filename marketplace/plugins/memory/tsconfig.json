{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM"],
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node", "vitest/globals"],
    "paths": {
      "@/*": ["./*"],
      "@bb/plugin-sdk": ["../../../packages/plugin-sdk/src/index.ts"],
      "@bb/plugin-sdk/*": ["../../../packages/plugin-sdk/src/*"]
    }
  },
  "include": ["*.ts", "*.tsx", "components", "lib", "skills"]
}
