{
  "name": "bb-plugin-github",
  "version": "0.1.0",
  "description": "Browse GitHub issues and pull requests in BB, then send them to agents.",
  "private": true,
  "license": "MIT",
  "homepage": "https://github.com/ymichael/bb#readme",
  "bugs": {
    "url": "https://github.com/ymichael/bb/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ymichael/bb.git",
    "directory": "marketplace/plugins/github"
  },
  "type": "module",
  "files": [
    "dist",
    "server.ts",
    "app.tsx",
    "components",
    "lib",
    "logo.svg",
    "logo-dark.svg",
    "README.md"
  ],
  "engines": {
    "bb": ">=0.0",
    "bbPluginSdk": "^0.2.0"
  },
  "bb": {
    "displayName": "GitHub",
    "icon": "Github",
    "server": "./server.ts",
    "app": "./app.tsx"
  },
  "keywords": [
    "bb-plugin"
  ],
  "scripts": {
    "build": "node --conditions=source --import tsx ../../../scripts/build-official-plugins.mjs github",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts"
  },
  "devDependencies": {
    "@pierre/diffs": "^1.2.9",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-select": "^2.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "sonner": "^1.7.4",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-7": "npm:typescript@^7.0.2",
    "vaul": "^1.1.2",
    "vitest": "^4.1.1"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.1.3",
    "@hugeicons/react": "^1.1.6",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-tabs": "^1.1.17",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.3.6"
  }
}
