{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM"],
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"],
    "paths": {
      "@/*": ["./*"],
      "@bb/plugin-sdk": ["../../../packages/plugin-sdk/src/index.ts"],
      "@bb/plugin-sdk/*": ["../../../packages/plugin-sdk/src/*"]
    }
  },
  "include": ["server.ts", "app.tsx", "components", "lib", "hooks"]
}
