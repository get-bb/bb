@@ -0,0 +1,215 @@
+package com.reactnativecommunity.webview;
+
+import android.content.ClipData;
+import android.content.ClipboardManager;
+import android.content.Context;
+import android.net.Uri;
+import android.os.SystemClock;
+import android.util.Log;
+import android.webkit.CookieManager;
+import android.webkit.MimeTypeMap;
+
+import androidx.core.content.FileProvider;
+
+import org.json.JSONObject;
+
+import java.io.File;
+import java.io.FileOutputStream;
+import java.io.IOException;
+import java.io.InputStream;
+import java.net.HttpURLConnection;
+import java.net.URI;
+import java.net.URL;
+import java.nio.charset.StandardCharsets;
+import java.util.Locale;
+import java.util.UUID;
+import java.util.concurrent.atomic.AtomicBoolean;
+import java.util.concurrent.atomic.AtomicReference;
+
+final class RNCWebViewClipboard {
+    private static final int MAX_BYTES = 35 * 1024 * 1024;
+    private final RNCWebView webView;
+    private final AtomicBoolean busy = new AtomicBoolean();
+    private final AtomicReference<HttpURLConnection> connection = new AtomicReference<>();
+    private volatile boolean destroyed;
+
+    RNCWebViewClipboard(RNCWebView webView) {
+        this.webView = webView;
+    }
+
+    boolean receive(String raw, String sourceUrl) {
+        if (webView.injectedJSBeforeContentLoaded == null
+                || !webView.injectedJSBeforeContentLoaded.contains("copyTextAndImage")) return false;
+        try {
+            JSONObject message = new JSONObject(raw);
+            if (!"request".equals(message.optString("type"))) return false;
+            JSONObject request = message.getJSONObject("request");
+            String kind = request.optString("kind");
+            if (!"clipboard".equals(kind) && !"clipboard-html".equals(kind)) return false;
+            String id = message.getString("id");
+            JSONObject payload = request.getJSONObject("payload");
+            String text = payload.getString("text");
+            if ("clipboard-html".equals(kind)) {
+                String html = payload.getString("html");
+                if (id.isEmpty() || id.length() > 64 || text.length() > 100000 || html.length() > 1000000) return false;
+                webView.post(() -> copyRichText(id, text, html, sourceUrl));
+                return true;
+            }
+            String imageUrl = payload.getString("imageUrl");
+            if (id.isEmpty() || id.length() > 64 || text.length() > 100000) return false;
+            webView.post(() -> start(id, text, imageUrl, sourceUrl));
+            return true;
+        } catch (Exception error) {
+            return false;
+        }
+    }
+
+    private void copyRichText(String id, String text, String html, String sourceUrl) {
+        if (destroyed) return;
+        try {
+            if (!sameOrigin(new URI(webView.getUrl()), new URI(sourceUrl))) throw new IOException("Copy must be on the current server");
+            ClipboardManager clipboard = (ClipboardManager) webView.getContext().getSystemService(Context.CLIPBOARD_SERVICE);
+            clipboard.setPrimaryClip(ClipData.newHtmlText("BB message", text, html));
+            respond(id, true, "");
+        } catch (Exception error) {
+            respond(id, false, error.getMessage());
+        }
+    }
+
+    private void start(String id, String text, String imageUrl, String sourceUrl) {
+        if (destroyed) return;
+        try {
+            URI page = new URI(webView.getUrl());
+            URI source = new URI(sourceUrl);
+            URI image = new URI(imageUrl);
+            if (!sameOrigin(page, source) || !sameOrigin(page, image)
+                    || image.getUserInfo() != null) throw new IOException("Image must be on the current server");
+            if (!busy.compareAndSet(false, true)) throw new IOException("An image copy is already running");
+            String cookie = CookieManager.getInstance().getCookie(imageUrl);
+            long deadline = SystemClock.elapsedRealtime() + 25000;
+            new Thread(() -> download(id, text, imageUrl, cookie, deadline), "BBClipboard").start();
+        } catch (Exception error) {
+            respond(id, false, error.getMessage());
+        }
+    }
+
+    private static boolean sameOrigin(URI left, URI right) {
+        String scheme = left.getScheme();
+        return ("https".equals(scheme) || "http".equals(scheme))
+                && scheme.equals(right.getScheme()) && left.getHost() != null
+                && left.getHost().equalsIgnoreCase(right.getHost())
+                && port(left) == port(right);
+    }
+
+    private static int port(URI uri) {
+        return uri.getPort() == -1 ? ("https".equals(uri.getScheme()) ? 443 : 80) : uri.getPort();
+    }
+
+    private void download(String id, String text, String url, String cookie, long deadline) {
+        File file = null;
+        HttpURLConnection http = null;
+        try {
+            http = (HttpURLConnection) new URL(url).openConnection();
+            connection.set(http);
+            http.setInstanceFollowRedirects(false);
+            http.setConnectTimeout(10000);
+            http.setReadTimeout(10000);
+            if (cookie != null) http.setRequestProperty("Cookie", cookie);
+            checkActive(deadline);
+            if (http.getResponseCode() != 200) throw new IOException("Image download failed");
+            String type = http.getContentType();
+            if (type == null) throw new IOException("Image type missing");
+            type = type.split(";", 2)[0].trim().toLowerCase(Locale.ROOT);
+            if (!type.startsWith("image/")) throw new IOException("Expected an image");
+            if (http.getContentLengthLong() > MAX_BYTES) throw new IOException("Image exceeds 35 MB");
+            String extension = MimeTypeMap.getSingleton().getExtensionFromMimeType(type);
+            if (extension == null) throw new IOException("Unsupported image type");
+            File directory = new File(webView.getContext().getCacheDir(), "bb-clipboard");
+            if (!directory.isDirectory() && !directory.mkdirs()) throw new IOException("Image cache unavailable");
+            File[] oldFiles = directory.listFiles();
+            if (oldFiles != null) {
+                long cutoff = System.currentTimeMillis() - 24 * 60 * 60 * 1000L;
+                for (File old : oldFiles) if (old.lastModified() < cutoff) old.delete();
+            }
+            file = new File(directory, UUID.randomUUID() + "." + extension);
+            int total = 0;
+            try (InputStream input = http.getInputStream(); FileOutputStream output = new FileOutputStream(file)) {
+                byte[] bytes = new byte[16384];
+                while (true) {
+                    checkActive(deadline);
+                    int count = input.read(bytes);
+                    if (count == -1) break;
+                    total += count;
+                    if (total > MAX_BYTES) throw new IOException("Image exceeds 35 MB");
+                    output.write(bytes, 0, count);
+                }
+            }
+            if (total == 0 || (http.getContentLengthLong() >= 0 && total != http.getContentLengthLong())) {
+                throw new IOException("Incomplete image");
+            }
+            checkActive(deadline);
+            if (!text.isEmpty()) {
+                try (FileOutputStream output = new FileOutputStream(file.getPath() + ".txt")) {
+                    output.write(text.getBytes(StandardCharsets.UTF_8));
+                }
+            }
+            Uri uri = FileProvider.getUriForFile(webView.getContext(),
+                    webView.getContext().getPackageName() + ".fileprovider", file);
+            File completed = file;
+            String mimeType = type;
+            webView.post(() -> {
+                try {
+                    checkActive(deadline);
+                    String[] mimeTypes = text.isEmpty()
+                            ? new String[]{mimeType}
+                            : new String[]{mimeType, "text/plain"};
+                    ClipData.Item item = new ClipData.Item(text.isEmpty() ? null : text, null, uri);
+                    ClipData clip = new ClipData("BB message", mimeTypes, item);
+                    ClipboardManager clipboard = (ClipboardManager) webView.getContext().getSystemService(Context.CLIPBOARD_SERVICE);
+                    clipboard.setPrimaryClip(clip);
+                    respond(id, true, "");
+                } catch (Exception error) {
+                    completed.delete();
+                    new File(completed.getPath() + ".txt").delete();
+                    respond(id, false, error.getMessage());
+                } finally {
+                    busy.set(false);
+                }
+            });
+            file = null;
+        } catch (Exception error) {
+            Log.w("BBClipboard", "Could not copy message image", error);
+            respond(id, false, error.getMessage());
+            busy.set(false);
+        } finally {
+            if (file != null) {
+                file.delete();
+                new File(file.getPath() + ".txt").delete();
+            }
+            if (http != null) {
+                connection.compareAndSet(http, null);
+                http.disconnect();
+            }
+        }
+    }
+
+    private void checkActive(long deadline) throws IOException {
+        if (destroyed || SystemClock.elapsedRealtime() >= deadline) throw new IOException("Image copy expired");
+    }
+
+    private void respond(String id, boolean copied, String error) {
+        webView.post(() -> {
+            if (destroyed) return;
+            String response = copied ? "{ok:true,result:{copied:true}}"
+                    : "{ok:false,error:" + JSONObject.quote(error == null ? "Image copy failed" : error) + "}";
+            webView.evaluateJavascript("(function(){var n=window.bb&&window.bb.native;if(n&&n.__receive)n.__receive({type:'response',id:"
+                    + JSONObject.quote(id) + ",response:" + response + "});})()", null);
+        });
+    }
+
+    void destroy() {
+        destroyed = true;
+        HttpURLConnection http = connection.getAndSet(null);
+        if (http != null) http.disconnect();
+    }
+}
