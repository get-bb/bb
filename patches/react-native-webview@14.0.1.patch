+package com.reactnativecommunity.webview;
+
+import android.content.ContentResolver;
+import android.content.res.AssetFileDescriptor;
+import android.database.Cursor;
+import android.net.Uri;
+import android.os.CancellationSignal;
+import android.provider.OpenableColumns;
+import android.system.ErrnoException;
+import android.system.Os;
+import android.system.OsConstants;
+import android.system.StructPollfd;
+import android.util.Log;
+import android.view.inputmethod.EditorInfo;
+import android.view.inputmethod.InputConnection;
+import android.webkit.MimeTypeMap;
+import android.webkit.WebResourceRequest;
+import android.webkit.WebResourceResponse;
+
+import androidx.core.view.inputmethod.EditorInfoCompat;
+import androidx.core.view.inputmethod.InputConnectionCompat;
+import androidx.core.view.inputmethod.InputContentInfoCompat;
+
+import org.json.JSONObject;
+
+import java.io.ByteArrayInputStream;
+import java.io.FilterInputStream;
+import java.io.IOException;
+import java.io.InputStream;
+import java.util.Collections;
+import java.util.Map;
+import java.util.UUID;
+import java.util.concurrent.ConcurrentHashMap;
+import java.util.concurrent.atomic.AtomicBoolean;
+import java.util.concurrent.atomic.AtomicReference;
+
+final class RNCWebViewImagePaste {
+    private static final int MAX_BYTES = 35 * 1024 * 1024;
+    private static final String PATH = "/__bb_keyboard_image/";
+    private final RNCWebView webView;
+    private volatile boolean destroyed;
+    private final Map<String, Transfer> transfers = new ConcurrentHashMap<>();
+
+    RNCWebViewImagePaste(RNCWebView webView) {
+        this.webView = webView;
+    }
+
+    InputConnection wrap(InputConnection connection, EditorInfo info) {
+        if (connection == null || webView.injectedJSBeforeContentLoaded == null
+                || !webView.injectedJSBeforeContentLoaded.contains("__beginImagePaste")) {
+            return connection;
+        }
+        EditorInfoCompat.setContentMimeTypes(info, new String[]{"image/*"});
+        return InputConnectionCompat.createWrapper(connection, info, (content, flags, options) -> {
+            if (!content.getDescription().hasMimeType("image/*")
+                    || !"content".equals(content.getContentUri().getScheme())) return false;
+            boolean granted = (flags & InputConnectionCompat.INPUT_CONTENT_GRANT_READ_URI_PERMISSION) != 0;
+            try {
+                if (granted) content.requestPermission();
+                if (!webView.post(() -> receive(content, granted))) {
+                    if (granted) content.releasePermission();
+                    return false;
+                }
+                return true;
+            } catch (Exception error) {
+                Log.w("BBImagePaste", "Could not receive keyboard image", error);
+                if (granted) content.releasePermission();
+                return false;
+            }
+        });
+    }
+
+    private void receive(InputContentInfoCompat content, boolean granted) {
+        if (destroyed) {
+            if (granted) content.releasePermission();
+            return;
+        }
+        Uri page = Uri.parse(webView.getUrl() == null ? "" : webView.getUrl());
+        if ((!"https".equals(page.getScheme()) && !"http".equals(page.getScheme()))
+                || transfers.size() >= 4) {
+            if (granted) content.releasePermission();
+            return;
+        }
+        String id = UUID.randomUUID().toString();
+        String url = page.buildUpon().path(PATH + id).clearQuery().fragment(null).build().toString();
+        Transfer transfer = new Transfer(id, url, content, granted);
+        transfers.put(url, transfer);
+        webView.postDelayed(transfer.expire, 30000);
+        String begin = "(function(){var n=window.bb&&window.bb.native;return !!(n&&n.__beginImagePaste&&n.__beginImagePaste("
+                + JSONObject.quote(id) + "," + JSONObject.quote(url) + "));})()";
+        webView.evaluateJavascript(begin, accepted -> {
+            if (!"true".equals(accepted)) transfer.complete(null);
+        });
+    }
+
+    WebResourceResponse intercept(WebResourceRequest request) {
+        String path = request.getUrl().getPath();
+        if (path == null || !path.startsWith(PATH)) return null;
+        Transfer transfer = transfers.get(request.getUrl().toString());
+        if (transfer == null || !"GET".equals(request.getMethod())
+                || !transfer.claimed.compareAndSet(false, true)) return unavailable();
+        try {
+            ContentResolver resolver = webView.getContext().getContentResolver();
+            Uri uri = transfer.content.getContentUri();
+            String type = resolver.getType(uri);
+            if (type == null) {
+                for (int i = 0; i < transfer.content.getDescription().getMimeTypeCount(); i++) {
+                    String candidate = transfer.content.getDescription().getMimeType(i);
+                    if (candidate.startsWith("image/")) { type = candidate; break; }
+                }
+            }
+            if (type == null || !type.startsWith("image/")) throw new IOException("Expected image");
+            String extension = MimeTypeMap.getSingleton().getExtensionFromMimeType(type);
+            String name = "clipboard-image" + (extension == null ? "" : "." + extension);
+            try (Cursor cursor = resolver.query(uri, new String[]{OpenableColumns.DISPLAY_NAME},
+                    null, null, null, transfer.cancellation)) {
+                if (cursor != null && cursor.moveToFirst() && !cursor.isNull(0)) {
+                    String candidate = cursor.getString(0);
+                    if (!candidate.trim().isEmpty()) name = candidate;
+                }
+            } catch (Exception error) {
+                Log.w("BBImagePaste", "Could not read image filename", error);
+            }
+            transfer.cancellation.throwIfCanceled();
+            AssetFileDescriptor descriptor = resolver.openAssetFileDescriptor(uri, "r", transfer.cancellation);
+            if (descriptor == null) throw new IOException("Image unavailable");
+            InputStream input;
+            try {
+                input = descriptor.createInputStream();
+            } catch (Exception error) {
+                descriptor.close();
+                throw error;
+            }
+            transfer.stream.set(input);
+            if (transfer.closed.get()) {
+                input.close();
+                throw new IOException("Image transfer expired");
+            }
+            JSONObject image = new JSONObject();
+            image.put("name", name);
+            image.put("type", type);
+            StructPollfd poll = new StructPollfd();
+            poll.fd = descriptor.getParcelFileDescriptor().getFileDescriptor();
+            poll.events = (short) OsConstants.POLLIN;
+            StructPollfd[] descriptors = new StructPollfd[]{poll};
+            InputStream bounded = new FilterInputStream(input) {
+                private int total;
+                private boolean ended;
+
+                @Override
+                public int read() throws IOException {
+                    byte[] single = new byte[1];
+                    return read(single, 0, 1) == -1 ? -1 : single[0] & 0xff;
+                }
+
+                @Override
+                public int read(byte[] bytes, int offset, int length) throws IOException {
+                    if (length == 0) return 0;
+                    if (ended) return -1;
+                    if (transfer.closed.get()) throw new IOException("Image transfer expired");
+                    try {
+                        while (!transfer.closed.get() && Os.poll(descriptors, 250) == 0) {}
+                        if (transfer.closed.get()) throw new IOException("Image transfer expired");
+                        int count = in.read(bytes, offset, Math.min(length, MAX_BYTES - total + 1));
+                        if (count == -1) {
+                            ended = true;
+                            transfer.complete(total == 0 ? null : image);
+                        } else {
+                            total += count;
+                            if (total > MAX_BYTES) throw new IOException("Image exceeds 35 MB");
+                        }
+                        return count;
+                    } catch (ErrnoException error) {
+                        transfer.complete(null);
+                        throw new IOException(error);
+                    } catch (IOException error) {
+                        transfer.complete(null);
+                        throw error;
+                    }
+                }
+
+                @Override
+                public void close() {
+                    transfer.complete(null);
+                }
+            };
+            return new WebResourceResponse(type, null, 200, "OK",
+                    Collections.singletonMap("Cache-Control", "no-store"), bounded);
+        } catch (Exception error) {
+            Log.w("BBImagePaste", "Could not stream keyboard image", error);
+            transfer.complete(null);
+            return unavailable();
+        }
+    }
+
+    void cancelAll() {
+        for (Transfer transfer : transfers.values()) transfer.complete(null);
+    }
+
+    void destroy() {
+        destroyed = true;
+        cancelAll();
+    }
+
