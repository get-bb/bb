+package com.reactnativecommunity.webview;
+
+import android.content.ContentResolver;
+import android.database.Cursor;
+import android.net.Uri;
+import android.provider.OpenableColumns;
+import android.util.Base64;
+import android.util.Log;
+import android.view.inputmethod.EditorInfo;
+import android.view.inputmethod.InputConnection;
+import android.webkit.MimeTypeMap;
+
+import androidx.core.view.inputmethod.EditorInfoCompat;
+import androidx.core.view.inputmethod.InputConnectionCompat;
+import androidx.core.view.inputmethod.InputContentInfoCompat;
+
+import org.json.JSONObject;
+
+import java.io.ByteArrayOutputStream;
+import java.io.InputStream;
+import java.util.UUID;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+
+final class RNCWebViewImagePaste {
+    private static final int MAX_BYTES = 35 * 1024 * 1024;
+    private static final ExecutorService READER = Executors.newSingleThreadExecutor();
+    private final RNCWebView webView;
+
+    RNCWebViewImagePaste(RNCWebView webView) {
+        this.webView = webView;
+    }
+
+    InputConnection wrap(InputConnection connection, EditorInfo info) {
+        if (connection == null || webView.injectedJSBeforeContentLoaded == null
+                || !webView.injectedJSBeforeContentLoaded.contains("__beginImagePaste")) {
+            return connection;
+        }
+        EditorInfoCompat.setContentMimeTypes(info, new String[]{"image/*"});
+        return InputConnectionCompat.createWrapper(connection, info, (content, flags, options) -> {
+            if (!content.getDescription().hasMimeType("image/*")) return false;
+            boolean granted = (flags & InputConnectionCompat.INPUT_CONTENT_GRANT_READ_URI_PERMISSION) != 0;
+            try {
+                if (granted) content.requestPermission();
+                webView.post(() -> receive(content, granted));
+                return true;
+            } catch (Exception error) {
+                Log.w("BBImagePaste", "Could not receive keyboard image", error);
+                if (granted) content.releasePermission();
+                return false;
+            }
+        });
+    }
+
+    private void receive(InputContentInfoCompat content, boolean granted) {
+        String id = UUID.randomUUID().toString();
+        String begin = "(function(){var n=window.bb&&window.bb.native;return !!(n&&n.__beginImagePaste&&n.__beginImagePaste("
+                + JSONObject.quote(id) + "));})()";
+        webView.evaluateJavascript(begin, accepted -> {
+            if (!"true".equals(accepted)) {
+                if (granted) content.releasePermission();
+                return;
+            }
+            READER.execute(() -> {
+                JSONObject image = null;
+                try {
+                    image = read(content.getContentUri(), content.getDescription().getMimeType(0));
+                } catch (Exception error) {
+                    Log.w("BBImagePaste", "Could not read keyboard image", error);
+                } finally {
+                    if (granted) content.releasePermission();
+                }
+                String payload = image == null ? "null" : image.toString();
+                webView.post(() -> webView.evaluateJavascript(
+                        "(function(){var n=window.bb&&window.bb.native;if(n&&n.__finishImagePaste)n.__finishImagePaste("
+                                + JSONObject.quote(id) + "," + payload + ");})()", null));
+            });
+        });
+    }
+
+    private JSONObject read(Uri uri, String advertisedType) throws Exception {
+        if (!"content".equals(uri.getScheme())) throw new IllegalArgumentException("Expected content URI");
+        ContentResolver resolver = webView.getContext().getContentResolver();
+        String type = resolver.getType(uri);
+        if (type == null) type = advertisedType;
+        if (type == null || !type.startsWith("image/")) throw new IllegalArgumentException("Expected image");
+        String extension = MimeTypeMap.getSingleton().getExtensionFromMimeType(type);
+        String name = "clipboard-image" + (extension == null ? "" : "." + extension);
+        try (Cursor cursor = resolver.query(uri, new String[]{OpenableColumns.DISPLAY_NAME}, null, null, null)) {
+            if (cursor != null && cursor.moveToFirst() && !cursor.isNull(0)) {
+                String candidate = cursor.getString(0);
+                if (!candidate.trim().isEmpty()) name = candidate;
+            }
+        }
+        try (InputStream stream = resolver.openInputStream(uri);
+             ByteArrayOutputStream bytes = new ByteArrayOutputStream()) {
+            if (stream == null) throw new IllegalArgumentException("Image unavailable");
+            byte[] buffer = new byte[16384];
+            int count;
+            while ((count = stream.read(buffer)) != -1) {
+                if (bytes.size() + count > MAX_BYTES) throw new IllegalArgumentException("Image exceeds 35 MB");
+                bytes.write(buffer, 0, count);
+            }
+            if (bytes.size() == 0) throw new IllegalArgumentException("Empty image");
+            JSONObject image = new JSONObject();
+            image.put("name", name);
+            image.put("type", type);
+            image.put("data", Base64.encodeToString(bytes.toByteArray(), Base64.NO_WRAP));
+            return image;
+        }
+    }
+}
