{
  "name": "@bb/connect-db",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./migrations": {
      "source": "./src/migrations.ts",
      "types": "./src/migrations.ts",
      "default": "./src/migrations.ts"
    }
  },
  "files": [
    "migrations"
  ],
  "scripts": {
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "typecheck": "tsrs --noEmit",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.38.0"
  },
  "devDependencies": {
    "@bb/tsconfig": "workspace:*",
    "@types/node": "^22.0.0",
    "drizzle-kit": "^0.30.0",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^4.1.1"
  }
}
