      "default": "./src/branch-options.ts"
    },
    "./git": {
      "source": "./src/git.ts",
      "types": "./src/git.ts",
      "default": "./src/git.ts"
    },
    "./git-types": {
      "source": "./src/git-types.ts",
      "types": "./src/git-types.ts",
      "default": "./src/git-types.ts"
    },
    "./locks": {
      "source": "./src/locks.ts",
      "types": "./src/locks.ts",
      "default": "./src/locks.ts"
    },
    "./process-local-lock": {
      "source": "./src/process-local-lock.ts",
      "types": "./src/process-local-lock.ts",
      "default": "./src/process-local-lock.ts"
    },
    "./progress": {
      "source": "./src/progress.ts",
      "types": "./src/progress.ts",
      "default": "./src/progress.ts"
    },
    "./terminal-output": {
      "source": "./src/terminal-output.ts",
      "types": "./src/terminal-output.ts",
      "default": "./src/terminal-output.ts"
    },
    "./transcript": {
      "source": "./src/transcript.ts",
