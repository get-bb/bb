{
  "name": "@bb/templates",
  "version": "0.0.1",
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./generated": {
      "source": "./src/generated/templates.generated.ts",
      "types": "./src/generated/templates.generated.ts",
      "default": "./src/generated/templates.generated.ts"
    },
    "./plugin-scaffold": {
      "source": "./src/plugin-scaffold.ts",
      "types": "./src/plugin-scaffold.ts",
      "default": "./src/plugin-scaffold.ts"
    }
  },
  "types": "./src/index.ts",
  "scripts": {
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "generate:templates": "node ./scripts/generate-templates.mjs",
    "generate:plugin-scaffold": "node ./scripts/generate-plugin-scaffold.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@bb/domain": "workspace:*",
    "gray-matter": "^4.0.3",
    "handlebars": "^4.7.8"
  },
  "devDependencies": {
    "@bb/tsconfig": "workspace:*",
    "@types/node": "^22.0.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-7": "npm:typescript@^7.0.2",
    "vitest": "^4.1.1"
  }
}
