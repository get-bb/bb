{
  "name": "@bb/db",
  "version": "0.0.1",
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./internal-environment-lifecycle": {
      "source": "./src/internal-environment-lifecycle.ts",
      "types": "./src/internal-environment-lifecycle.ts",
      "default": "./src/internal-environment-lifecycle.ts"
    },
    "./query-plan-test-guard": {
      "source": "./src/query-plan-test-guard.ts",
      "types": "./src/query-plan-test-guard.ts",
      "default": "./src/query-plan-test-guard.ts"
    },
    "./testing": {
      "source": "./src/testing.ts",
      "types": "./src/testing.ts",
      "default": "./src/testing.ts"
    }
  },
  "types": "./src/index.ts",
  "files": [
    "drizzle"
  ],
  "scripts": {
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "typecheck": "tsrs --noEmit",
    "lint:type-aware": "oxlint -c ../../.oxlintrc.type-aware.json",
    "test": "vitest run --config vitest.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "check:query-plan-report": "tsx scripts/check-query-plan-report.ts",
    "list:query-functions": "tsx scripts/list-query-functions.ts"
  },
  "dependencies": {
    "@bb/config": "workspace:*",
    "@bb/domain": "workspace:*",
    "@bb/text-utils": "workspace:*",
    "better-sqlite3": "12.11.1",
    "drizzle-orm": "^0.45.4",
    "nanoid": "^5.1.16"
  },
  "devDependencies": {
    "@bb/tsconfig": "workspace:*",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.20.5",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^4.1.12"
  }
}
