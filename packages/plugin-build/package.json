{
  "name": "@bb/plugin-build",
  "version": "0.0.1",
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "types": "./src/index.ts",
  "scripts": {
    "clean": "rimraf tsconfig.tsbuildinfo",
    "test": "vitest run --config vitest.config.ts",
    "generate": "node ./scripts/generate-plugin-theme.mjs && node ./scripts/generate-runtime-export-manifest.mjs && node ./scripts/generate-build-fingerprint.mjs",
    "typecheck": "tsc --noEmit",
    "build": "node ../../scripts/build-node-entry.mjs src/build-bundled-plugin.ts dist/build-bundled-plugin.js"
  },
  "dependencies": {
    "@bb/domain": "workspace:*",
    "@bb/process-utils": "workspace:*",
    "@get-bb/plugin-sdk": "workspace:*",
    "saxes": "^6.0.0",
    "tar": "7.5.22",
    "zod": "^4.3.6",
    "proper-lockfile": "^4.1.2"
  },
  "devDependencies": {
    "@bb/tsconfig": "workspace:*",
    "@tailwindcss/node": "^4.3.0",
    "@tailwindcss/oxide": "^4.3.0",
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-7": "npm:typescript@^7.0.2",
    "vitest": "^4.1.1"
  }
}
