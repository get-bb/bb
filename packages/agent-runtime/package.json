{
  "name": "@bb/agent-runtime",
  "version": "0.0.1",
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./test": {
      "source": "./src/test/index.ts",
      "types": "./src/test/index.ts",
      "default": "./src/test/index.ts"
    }
  },
  "types": "./src/index.ts",
  "scripts": {
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "generate:test-bridges": "node ./scripts/build-test-bridges.mjs",
    "lint": "oxlint src",
    "typecheck": "tsrs --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@bb/domain": "workspace:*",
    "@bb/process-utils": "workspace:*",
    "@bb/provider-bridge-protocol": "workspace:*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@bb/plugin-build": "workspace:*",
    "@bb/test-helpers": "workspace:*",
    "@bb/tsconfig": "workspace:*",
    "@get-bb/plugin-sdk": "workspace:*",
    "@types/node": "^22.20.5",
    "bb-plugin-scripted-echo-provider": "workspace:*",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^4.1.12"
  }
}
