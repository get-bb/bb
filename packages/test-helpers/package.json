{
  "name": "@bb/test-helpers",
  "version": "0.0.1",
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./domain-fixtures": {
      "source": "./src/domain-fixtures.ts",
