    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^4.1.1"
  },
  "peerDependencies": {
    "vitest": "^4.1.1"
  }
