{
  "name": "@bb/agent-instructions-eval",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsrs --noEmit",
    "lint:type-aware": "oxlint -c ../../.oxlintrc.type-aware.json",
    "test": "vitest run --config vitest.config.ts",
    "context": "tsx --conditions=source src/context-report.ts",
    "eval": "tsx --conditions=source src/run.ts"
  },
  "dependencies": {
    "@bb/bundled-plugins": "workspace:*",
    "@get-bb/plugin-sdk": "workspace:*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@bb/tsconfig": "workspace:*",
    "@types/node": "^22.20.5",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^4.1.12"
  }
}
