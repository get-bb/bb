# bb-fork(windows): Node resolves a package's "#imports" through a native
# package-scope lookup that cannot read a package.json at a path of 260
# characters or more and reports it as missing, which breaks vitest and vite
# builds in deep worktrees. Shortened virtual-store directory names keep a deep
# checkout under that limit; see docs/windows.md. Changing this value requires
# `pnpm install --force`.
virtual-store-dir-max-length=50
