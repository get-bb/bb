{
  "name": "bb-plugin-provider-codex",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Run bb threads with Codex.",
  "engines": {
    "bb": ">=0.0",
    "bbPluginSdk": ">=0.6.57"
  },
  "bb": {
    "name": "Codex provider",
    "description": "Run bb threads with Codex.",
    "branding": {
      "icon": "./icons/codex.svg"
    },
    "server": "./server.ts",
    "app": "./app.tsx",
    "host": "./src/host.ts",
    "experimental_providers": [
      {
        "kind": "agent",
        "id": "codex",
        "displayName": "Codex"
      }
    ]
  },
  "keywords": [
    "bb-plugin"
  ],
  "scripts": {
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsrs --noEmit",
    "lint": "oxlint --ignore-pattern node_modules --ignore-pattern dist .",
    "prepare:bundled": "bb-plugin-build prepare-bundled"
  },
  "devDependencies": {
    "@bb/plugin-build": "workspace:*",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "better-sqlite3": "12.10.0",
    "cron-parser": "^5.5.0",
    "hono": "4.11.9",
    "jsdom": "^29.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^4.1.1"
  },
  "dependencies": {
    "@bb/shared-ui": "workspace:*",
    "@get-bb/plugin-sdk": "workspace:*",
    "zod": "^4.3.6"
  }
}
