{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "noEmit": true,
    "skipLibCheck": true,
    "paths": {
      "@/*": ["../../packages/shared-ui/src/*"]
    },
    "types": ["node"],
    "jsx": "react-jsx"
  },
  "include": ["server.ts", "src", "vitest.config.ts", "app.tsx", "app.test.tsx"]
}
