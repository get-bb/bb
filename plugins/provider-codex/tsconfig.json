{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "noEmit": true,
    "skipLibCheck": true,
    "paths": {
      "@get-bb/plugin-sdk": [
        "../../packages/plugin-sdk/bundled-types/bb-plugin-sdk.d.ts"
      ],
      "@get-bb/plugin-sdk/app": [
        "../../packages/plugin-sdk/bundled-types/bb-plugin-sdk-app.d.ts"
      ],
      "@/components/ui/icon": [
        "../../packages/plugin-registry/flavors/components/ui/icon.tsx"
      ],
      "@/components/ui/question-form-host": [
        "../../packages/plugin-registry/flavors/components/ui/question-form-host.tsx"
      ],
      "@/*": ["../../packages/shared-ui/src/*"]
    },
    "types": ["node"],
    "jsx": "react-jsx"
  },
  "include": ["server.ts", "app.tsx", "src", "vitest.config.ts"]
}
