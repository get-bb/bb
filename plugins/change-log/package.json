{
  "name": "bb-plugin-change-log",
  "version": "0.1.0",
  "description": "Browse a thread's file-change history in the thread right panel.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "bb": ">=0.0",
    "bbPluginSdk": ">=0.4.13"
  },
  "bb": {
    "name": "Change Log",
    "description": "Browse a thread's file-change history in the thread right panel.",
    "branding": {
      "icon": "Clock"
    },
    "server": "./server.ts",
    "app": "./app.tsx"
  },
  "keywords": [
    "bb-plugin"
  ],
  "scripts": {
    "prepare:bundled": "bb-plugin-build prepare-bundled",
    "build": "node --conditions=source --import tsx ./scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts"
  },
  "devDependencies": {
    "@bb/plugin-build": "workspace:*",
    "@get-bb/plugin-sdk": "workspace:*",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^29.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^4.1.1"
  },
  "dependencies": {
    "@bb/shared-ui": "workspace:*",
    "zod": "^4.1.6"
  },
  "files": [
    "dist",
    "server.ts",
    "app.tsx",
    "server",
    "components",
    "lib",
    "shared",
    "scripts",
    "README.md"
  ]
}
