{
  "name": "bb-plugin-git-graph",
  "version": "0.1.0",
  "description": "Read-only Git graph panel for project checkouts, nested repositories, worktrees, and submodules.",
  "private": true,
  "license": "MIT",
  "homepage": "https://github.com/get-bb/bb#readme",
  "bugs": {
    "url": "https://github.com/get-bb/bb/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/get-bb/bb.git",
    "directory": "plugins/git-graph"
  },
  "type": "module",
  "files": [
    "dist",
    "server.ts",
    "app.tsx",
    "contract.ts",
    "host.ts",
    "host-contract.ts",
    "git",
    "graph",
    "components",
    "README.md"
  ],
  "engines": {
    "bb": ">=0.0",
    "bbPluginSdk": ">=0.4.10"
  },
  "bb": {
    "name": "Git Graph",
    "description": "Read-only Git graph panel for project checkouts, nested repositories, worktrees, and submodules.",
    "branding": {
      "icon": "GitBranch"
    },
    "server": "./server.ts",
    "app": "./app.tsx",
    "host": "./host.ts"
  },
  "keywords": [
    "bb-plugin"
  ],
  "scripts": {
    "build": "node --conditions=source --import tsx ../../apps/cli/src/index.ts plugin build .",
    "prepare:bundled": "bb-plugin-build prepare-bundled",
    "gallery": "node gallery/serve.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts"
  },
  "devDependencies": {
    "@bb/plugin-build": "workspace:*",
    "@get-bb/plugin-sdk": "workspace:*",
    "@testing-library/react": "^16.3.2",
    "@types/d3-shape": "^3.1.8",
    "d3": "^7.9.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^29.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^1.7.4",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-7": "npm:typescript@^7.0.2",
    "vaul": "^1.1.2",
    "vitest": "^4.1.1"
  },
  "dependencies": {
    "@bb/shared-ui": "workspace:*",
    "@radix-ui/react-slot": "^1.3.0",
    "d3-shape": "^3.2.0",
    "zod": "^4.3.6"
  }
}
