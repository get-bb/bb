{
  "name": "bb-plugin-bb--mcp-apps",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Display MCP Apps in BB's thread side panel.",
  "engines": {
    "bb": ">=0.43",
    "bbPluginSdk": ">=0.5.9"
  },
  "bb": {
    "name": "MCP Apps",
    "description": "Connect to an MCP server and display its interactive tools beside a BB chat.",
    "branding": { "icon": "AppWindow" },
    "server": "./server.ts",
    "app": "./app.tsx",
    "skills": ["skills"]
  },
  "keywords": ["bb-plugin"],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepare:bundled": "bb-plugin-build prepare-bundled"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "@modelcontextprotocol/ext-apps": "1.1.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@bb/plugin-build": "workspace:*",
    "@get-bb/plugin-sdk": "workspace:*",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "jsdom": "^29.0.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^4.1.1"
  }
}
