{
  "name": "bb-plugin-conductor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Conductor-style layout for bb: a sidebar of projects and workspaces, where a workspace is every thread sharing one environment.",
  "engines": {
    "bb": ">=0.0",
    "bbPluginSdk": ">=0.6.141"
  },
  "bb": {
    "name": "Conductor layout",
    "description": "A sidebar of projects and workspaces: one row per environment, with its branch, pull request, and line changes.",
    "branding": {
      "icon": "FolderGit"
    },
    "server": "./server.ts",
    "app": "./app.tsx"
  },
  "keywords": [
    "bb-plugin"
  ],
  "scripts": {
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsrs --noEmit",
    "lint:type-aware": "oxlint -c ../../.oxlintrc.type-aware.json",
    "lint": "oxlint --ignore-pattern node_modules --ignore-pattern dist ."
  },
  "dependencies": {
    "@bb/shared-ui": "workspace:*",
    "sonner": "^1.7.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@bb/plugin-build": "workspace:*",
    "@get-bb/plugin-sdk": "workspace:*",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^29.1.1",
    "oxlint": "^1.91.0",
    "oxlint-tsgolint": "^7.0.2006",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^4.1.12"
  }
}
