{
  "name": "bb-plugin-bb--git",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Git status, changed files and diffs for each environment",
  "engines": {
    "bb": ">=0.0",
    "bbPluginSdk": ">=0.6.84"
  },
  "bb": {
    "name": "Git",
    "description": "Git status, changed files and diffs for each environment",
    "branding": {
      "icon": "GitBranch"
    },
    "server": "./server.ts",
    "host": "./host.ts"
  },
  "exports": {
    "./contract": "./contract.ts",
    "./rpc-contract": "./rpc-contract.ts",
    "./testing": "./testing.ts"
  },
  "keywords": [
    "bb-plugin"
  ],
  "scripts": {
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsrs --noEmit",
    "lint": "oxlint --ignore-pattern node_modules --ignore-pattern dist .",
    "prepare:bundled": "bb-plugin-build prepare-bundled"
  },
  "dependencies": {
    "@bb/async-cache": "workspace:*",
    "@bb/domain": "workspace:*",
    "@bb/server-contract": "workspace:*",
    "bb-environment-provider-host": "workspace:*",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@bb/host-daemon-contract": "workspace:*",
    "@bb/plugin-build": "workspace:*",
    "@bb/test-helpers": "workspace:*",
    "@get-bb/plugin-sdk": "workspace:*",
    "@types/node": "^22.0.0",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^4.1.1"
  }
}
