{
  "name": "bb-plugin-notes",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A Markdown-only source editor for your ~/Notes directory.",
  "license": "MIT",
  "homepage": "https://github.com/get-bb/bb#readme",
