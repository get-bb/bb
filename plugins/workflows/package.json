{
  "name": "bb-plugin-workflows",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Run durable, provider-independent agent workflows.",
  "engines": {
    "bb": ">=0.0",
    "bbPluginSdk": ">=0.6.113"
  },
  "bb": {
    "name": "Workflows",
    "description": "Run durable, provider-independent agent workflows.",
    "branding": {
      "icon": "Workflow"
    },
    "server": "./src/server.ts",
    "app": "./src/app.tsx",
    "skills": [
      "skills"
    ]
  },
  "keywords": [
    "bb-plugin"
  ],
  "scripts": {
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsrs --noEmit",
    "lint:type-aware": "oxlint -c ../../.oxlintrc.type-aware.json",
    "lint": "oxlint --ignore-pattern node_modules --ignore-pattern dist .",
    "prepare:bundled": "bb-plugin-build prepare-bundled"
  },
  "dependencies": {
    "@bb/shared-ui": "workspace:*",
    "@jitl/quickjs-singlefile-cjs-release-sync": "^0.32.0",
    "acorn": "8.19.0",
    "acorn-walk": "^8.3.5",
    "ajv": "^8.20.0",
    "quickjs-emscripten-core": "^0.32.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@bb/plugin-build": "workspace:*",
    "@get-bb/plugin-sdk": "workspace:*",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "better-sqlite3": "12.11.1",
    "cron-parser": "^5.10.3",
    "hono": "4.13.16",
    "jsdom": "^29.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^4.1.12"
  }
}
