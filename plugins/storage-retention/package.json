{
  "name": "bb-plugin-storage-retention",
  "version": "0.1.0",
  "description": "Inspect machine storage and automatically archive or delete old threads.",
  "private": true,
  "type": "module",
  "engines": {
    "bb": ">=0.0",
    "bbPluginSdk": ">=0.5.31"
  },
  "bb": {
    "name": "Storage & retention",
    "description": "Inspect machine storage and automatically archive or delete old threads.",
    "branding": {
      "icon": "FolderOpen"
    },
    "server": "./src/server.ts",
    "app": "./app.tsx",
    "skills": [
      "skills"
    ],
    "host": "./src/host.ts"
  },
  "keywords": [
    "bb-plugin"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --ignore-pattern node_modules --ignore-pattern dist .",
    "test": "vitest run --config vitest.config.ts",
    "prepare:bundled": "bb-plugin-build prepare-bundled"
  },
  "dependencies": {
    "@bb/shared-ui": "workspace:*",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@bb/plugin-build": "workspace:*",
    "@get-bb/plugin-sdk": "workspace:*",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^4.1.1"
  }
}
