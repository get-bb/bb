{
  "name": "bb-plugin-bb--chat",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A chat-first bb: a conversation list and a chat, with bb's sidebar and IDE controls hidden.",
  "engines": {
    "bb": ">=0.0",
    "bbPluginSdk": ">=0.6.166"
  },
  "bb": {
    "name": "Chat",
    "description": "Turn bb into a chat app: a list of conversations and a chat. Agents still run wherever bb runs them; the sidebar, pickers, and panels are hidden.",
    "branding": {
      "icon": "MessageSquare"
    },
    "server": "./server.ts",
    "app": "./app.tsx"
  },
  "keywords": [
    "bb-plugin"
  ],
  "scripts": {
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsrs --noEmit",
    "lint:type-aware": "oxlint -c ../../.oxlintrc.type-aware.json",
    "lint": "oxlint --ignore-pattern node_modules --ignore-pattern dist .",
    "prepare:bundled": "bb-plugin-build prepare-bundled"
  },
  "dependencies": {
    "@bb/shared-ui": "workspace:*"
  },
  "devDependencies": {
    "@bb/plugin-build": "workspace:*",
    "@get-bb/plugin-sdk": "workspace:*",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^29.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^4.1.12"
  }
}
