{
  "name": "bb-plugin-bb--github-pr-status",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "GitHub pull request status and actions for each environment's branch",
  "engines": {
    "bb": ">=0.0",
    "bbPluginSdk": ">=0.6.94"
