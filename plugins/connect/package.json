{
  "name": "bb-plugin-connect",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "Remote access via getbb.app — this bb becomes reachable at https://<handle>.getbb.app. Disable to cut off all remote access.",
  "engines": {
    "bb": ">=0.0",
    "bbPluginSdk": ">=0.6.131"
  },
  "bb": {
    "name": "bb connect",
    "description": "Remote access via getbb.app — this bb becomes reachable at https://<handle>.getbb.app. Disable to cut off all remote access.",
    "branding": {
      "icon": "ComputerCloud"
    },
    "server": "./src/server.ts",
    "app": "./app.tsx"
  },
  "keywords": [
    "bb-plugin"
  ],
  "scripts": {
    "typecheck": "tsrs --noEmit",
    "lint:type-aware": "oxlint -c ../../.oxlintrc.type-aware.json",
    "test": "vitest run --config vitest.config.ts",
    "prepare:bundled": "bb-plugin-build prepare-bundled"
  },
  "dependencies": {
    "@bb/connect-client": "workspace:*",
    "@bb/domain": "workspace:*",
    "@bb/shared-ui": "workspace:*",
    "@bb/tunnel-client": "workspace:*",
    "@bb/tunnel-contract": "workspace:*",
    "bb-plugin-bb-account": "workspace:*",
    "qrcode": "^1.5.4",
    "ws": "^8.22.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@bb/plugin-build": "workspace:*",
    "@get-bb/plugin-sdk": "workspace:*",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/ws": "^8.18.2",
    "better-sqlite3": "12.11.1",
    "jsdom": "^29.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^4.1.12"
  }
}
