        "registry-opencode": "./icons/registry-opencode.svg",
        "registry-pi-acp": "./icons/registry-pi-acp.svg",
        "registry-poolside": "./icons/registry-poolside.svg",
        "registry-qoder": "./icons/registry-qoder.svg",
        "registry-qwen-code": "./icons/registry-qwen-code.svg",
        "registry-sigit": "./icons/registry-sigit.svg",
        "registry-stakpak": "./icons/registry-stakpak.svg",
        "registry-vtcode": "./icons/registry-vtcode.svg"
      }
    },
    "server": "./server.ts",
    "app": "./app.tsx",
    "host": "./src/host.ts",
    "experimental_providers": [
      {
        "kind": "agent",
        "id": "acp-cursor",
        "displayName": "Cursor"
      },
      {
        "kind": "agent",
        "id": "acp-opencode",
        "displayName": "OpenCode"
      },
      {
        "kind": "agent",
        "id": "acp-omp",
        "displayName": "oh-my-pi"
      },
      {
        "kind": "agent",
        "id": "acp-grok",
        "displayName": "Grok"
      },
      {
        "kind": "agent",
        "id": "acp-hermes-agent",
        "displayName": "Hermes"
      }
    ]
  },
  "keywords": [
    "bb-plugin"
  ],
  "scripts": {
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --ignore-pattern node_modules --ignore-pattern dist .",
    "prepare:bundled": "bb-plugin-build prepare-bundled"
  },
  "devDependencies": {
    "@bb/plugin-build": "workspace:*",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "better-sqlite3": "12.10.0",
    "cron-parser": "^5.5.0",
    "hono": "4.11.9",
    "jsdom": "^29.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-7": "npm:typescript@^7.0.2",
    "vitest": "^4.1.1"
  },
  "dependencies": {
    "@bb/shared-ui": "workspace:*",
    "@get-bb/plugin-sdk": "workspace:*",
    "smol-toml": "^1.7.1",
    "yaml": "^2.9.0",
    "zod": "^4.3.6"
  }
}
