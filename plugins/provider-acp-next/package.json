    "branding": {
      "icon": "./icons/acp.svg",
      "experimental_icons": {
        "cursor": "./icons/cursor.svg",
        "opencode": "./icons/opencode.svg",
        "omp": "./icons/omp.svg",
        "grok": "./icons/grok.svg",
        "hermes-agent": "./icons/hermes-agent.svg",
        "registry-agoragentic-acp": "./icons/registry-agoragentic-acp.svg",
        "registry-amp-acp": "./icons/registry-amp-acp.svg",
        "registry-antigravity-acp": "./icons/registry-antigravity-acp.svg",
        "registry-auggie": "./icons/registry-auggie.svg",
        "registry-autohand": "./icons/registry-autohand.svg",
        "registry-claude-acp": "./icons/registry-claude-acp.svg",
        "registry-cline": "./icons/registry-cline.svg",
        "registry-codebuddy-code": "./icons/registry-codebuddy-code.svg",
        "registry-codex-acp": "./icons/registry-codex-acp.svg",
        "registry-cortex-code": "./icons/registry-cortex-code.svg",
        "registry-corust-agent": "./icons/registry-corust-agent.svg",
        "registry-crow-cli": "./icons/registry-crow-cli.svg",
        "registry-cursor": "./icons/registry-cursor.svg",
        "registry-deepagents": "./icons/registry-deepagents.svg",
        "registry-devin": "./icons/registry-devin.svg",
        "registry-dimcode": "./icons/registry-dimcode.svg",
        "registry-dirac": "./icons/registry-dirac.svg",
        "registry-factory-droid": "./icons/registry-factory-droid.svg",
        "registry-fast-agent": "./icons/registry-fast-agent.svg",
        "registry-gemini": "./icons/registry-gemini.svg",
        "registry-github-copilot-cli": "./icons/registry-github-copilot-cli.svg",
        "registry-glm-acp-agent": "./icons/registry-glm-acp-agent.svg",
        "registry-goose": "./icons/registry-goose.svg",
        "registry-grok-build": "./icons/registry-grok-build.svg",
        "registry-harn": "./icons/registry-harn.svg",
        "registry-junie": "./icons/registry-junie.svg",
        "registry-kilo": "./icons/registry-kilo.svg",
        "registry-kimchi": "./icons/registry-kimchi.svg",
        "registry-kimi": "./icons/registry-kimi.svg",
        "registry-minimax-code": "./icons/registry-minimax-code.svg",
