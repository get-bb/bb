{
  "name": "bb-plugin-bb-account",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Signs this bb in to your getbb.app account and holds its server credential for remote access and hosted services.",
  "engines": {
    "bb": ">=0.0",
    "bbPluginSdk": ">=0.4.102"
  },
  "bb": {
    "name": "bb account",
    "description": "Signs this bb in to your getbb.app account and holds its server credential for remote access and hosted services.",
    "branding": {
      "icon": "UserRound"
    },
    "server": "./src/server.ts",
    "app": "./app.tsx"
  },
  "keywords": [
    "bb-plugin"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "prepare:bundled": "bb-plugin-build prepare-bundled"
  },
  "dependencies": {
    "@bb/connect-client": "workspace:*",
    "@bb/shared-ui": "workspace:*",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@bb/plugin-build": "workspace:*",
    "@get-bb/plugin-sdk": "workspace:*",
    "@radix-ui/react-dialog": "^1.1.19",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/ws": "^8.18.1",
    "jsdom": "^29.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vaul": "^1.1.2",
    "vitest": "^4.1.1",
    "ws": "^8.18.0"
  }
}
