{
  "name": "bb-plugin-bb-account",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Signs this bb in to your getbb.app account and holds its server credential for remote access and hosted services.",
  "engines": {
    "bb": ">=0.0",
    "bbPluginSdk": ">=0.6.63"
  },
  "bb": {
    "name": "bb account",
    "description": "Signs this bb in to your getbb.app account and holds its server credential for remote access and hosted services.",
    "branding": {
      "icon": "UserRound"
    },
    "server": "./src/server.ts",
    "app": "./app.tsx"
  },
  "keywords": [
    "bb-plugin"
  ],
  "scripts": {
    "typecheck": "tsrs --noEmit",
    "lint:type-aware": "oxlint -c ../../.oxlintrc.type-aware.json",
    "test": "vitest run --config vitest.config.ts",
    "prepare:bundled": "bb-plugin-build prepare-bundled"
  },
  "dependencies": {
    "@bb/connect-client": "workspace:*",
    "@bb/shared-ui": "workspace:*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@bb/plugin-build": "workspace:*",
    "@get-bb/plugin-sdk": "workspace:*",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/ws": "^8.18.2",
    "jsdom": "^29.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^4.1.12",
    "ws": "^8.22.1"
  }
}
