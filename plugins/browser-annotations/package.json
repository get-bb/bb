  },
  "dependencies": {
    "@bb/shared-ui": "workspace:*",
    "sonner": "^1.7.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@bb/sdk": "workspace:*",
    "@get-bb/plugin-sdk": "workspace:*",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^29.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^4.1.1"
