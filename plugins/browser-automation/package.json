{
  "name": "bb-plugin-browser-automation",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "Let BB control the in-app browser and browsers on connected machines, with inline previews for headless sessions.",
  "engines": {
    "bb": ">=0.41",
    "bbPluginSdk": ">=0.6.113"
  },
  "bb": {
    "name": "Browser Automation",
    "description": "Let BB control the in-app browser and browsers on connected machines, with inline previews for headless sessions.",
    "branding": {
      "icon": "Globe"
    },
    "server": "./server.ts",
    "host": "./host.ts",
    "app": "./app.tsx",
    "skills": [
      "skills"
    ]
  },
  "scripts": {
    "build": "node ../../apps/cli/dist/index.js plugin build",
    "typecheck": "tsrs --noEmit",
    "lint:type-aware": "oxlint -c ../../.oxlintrc.type-aware.json",
    "lint": "oxlint --ignore-pattern node_modules --ignore-pattern dist .",
    "test": "vitest run --config vitest.config.ts",
    "smoke": "tsx --tsconfig tsconfig.smoke.json smoke.ts",
    "smoke:install": "tsx --tsconfig tsconfig.smoke.json smoke-install.ts",
    "prepare:bundled": "bb-plugin-build prepare-bundled"
  },
  "dependencies": {
    "@bb/shared-ui": "workspace:*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@bb/plugin-build": "workspace:*",
    "@get-bb/plugin-sdk": "workspace:*",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "better-sqlite3": "12.11.1",
    "cron-parser": "^5.10.3",
    "hono": "4.13.16",
    "jsdom": "^29.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^4.1.12"
  }
}
