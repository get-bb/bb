{
  "name": "bb-plugin-browser-automation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Let BB control the in-app browser and browsers on connected machines, with inline previews for headless sessions.",
  "engines": {
    "bb": ">=0.41",
    "bbPluginSdk": ">=0.4.102"
  },
  "bb": {
    "name": "Browser Automation",
    "description": "Let BB control the in-app browser and browsers on connected machines, with inline previews for headless sessions.",
    "branding": {
      "icon": "Globe"
    },
    "server": "./server.ts",
    "host": "./host.ts",
    "app": "./app.tsx",
    "skills": [
      "skills"
    ]
  },
  "scripts": {
    "build": "node ../../apps/cli/dist/index.js plugin build",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --ignore-pattern node_modules --ignore-pattern dist .",
    "test": "vitest run --config vitest.config.ts",
    "smoke": "tsx --tsconfig tsconfig.smoke.json smoke.ts",
    "smoke:install": "tsx --tsconfig tsconfig.smoke.json smoke-install.ts",
    "prepare:bundled": "bb-plugin-build prepare-bundled"
  },
  "dependencies": {
    "@bb/shared-ui": "workspace:*",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@bb/plugin-build": "workspace:*",
    "@get-bb/plugin-sdk": "workspace:*",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "better-sqlite3": "12.10.0",
    "cron-parser": "^5.5.0",
    "hono": "4.11.9",
    "jsdom": "^29.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.21.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^4.1.1"
  }
}
