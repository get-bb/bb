{
  "name": "bb-plugin-bb-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Thread titles and commit messages from bb cloud, included with your bb account.",
  "engines": {
    "bb": ">=0.0",
    "bbPluginSdk": ">=0.5.23"
  },
  "bb": {
    "name": "bb cloud AI",
    "description": "Thread titles and commit messages from bb cloud, included with your bb account.",
    "branding": {
      "icon": "AiBrain01"
    },
    "server": "./src/server.ts",
    "app": "./app.tsx",
    "skills": [
      "skills"
    ]
  },
  "keywords": [
    "bb-plugin"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --ignore-pattern node_modules --ignore-pattern dist .",
    "test": "vitest run --config vitest.config.ts",
    "prepare:bundled": "bb-plugin-build prepare-bundled"
  },
  "dependencies": {
    "@bb/shared-ui": "workspace:*",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@bb/plugin-build": "workspace:*",
    "@get-bb/plugin-sdk": "workspace:*",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^29.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^4.1.1"
  }
}
