{
  "name": "bb-plugin-navigation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "bb's sidebar navigation: the Rail and Top list layouts for New thread, Plugins, Skills, Automations, and plugin panels.",
  "engines": {
    "bb": ">=0.0",
    "bbPluginSdk": ">=0.6.53"
  },
  "bb": {
    "name": "Navigation",
    "description": "bb's sidebar navigation: the Rail and Top list layouts for New thread, Plugins, Skills, Automations, and plugin panels.",
    "branding": {
      "icon": "PanelLeft"
    },
    "server": "./server.ts",
    "app": "./app.tsx"
  },
  "keywords": [
    "bb-plugin"
  ],
  "scripts": {
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsrs --noEmit",
    "lint": "oxlint --ignore-pattern node_modules --ignore-pattern dist .",
    "prepare:bundled": "bb-plugin-build prepare-bundled"
  },
  "dependencies": {
    "@bb/shared-ui": "workspace:*"
  },
  "devDependencies": {
    "@bb/plugin-build": "workspace:*",
    "@get-bb/plugin-sdk": "workspace:*",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^29.1.1",
    "oxlint": "^1.91.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^4.1.12"
  }
}
