{
  "name": "bb-plugin-bb--composer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "bb's composer: the prompt box with rich text, @-mentions, slash commands, voice and attachments.",
  "engines": {
    "bb": ">=0.0",
    "bbPluginSdk": ">=0.6.66"
  },
  "bb": {
    "name": "Composer",
    "description": "bb's composer: the prompt box with rich text, @-mentions, slash commands, voice and attachments.",
    "branding": {
      "icon": "MessageSquare"
    },
    "server": "./server.ts",
    "app": "./app.tsx"
  },
  "keywords": [
    "bb-plugin"
  ],
  "scripts": {
    "test": "vitest run --config vitest.config.ts",
    "bench": "cross-env PROMPTBOX_PERF=1 vitest run --config vitest.config.ts src/editor/prompt-paste-performance.test.ts",
    "typecheck": "tsrs --noEmit",
    "lint": "oxlint --ignore-pattern node_modules --ignore-pattern dist .",
    "prepare:bundled": "bb-plugin-build prepare-bundled"
  },
  "dependencies": {
    "@bb/shared-ui": "workspace:*",
    "@tiptap/core": "^3.26.0",
    "@tiptap/extension-blockquote": "^3.26.0",
    "@tiptap/extension-document": "^3.26.0",
    "@tiptap/extension-hard-break": "^3.26.0",
    "@tiptap/extension-mention": "^3.26.0",
    "@tiptap/extension-paragraph": "^3.26.0",
    "@tiptap/extension-text": "^3.26.0",
    "@tiptap/extensions": "^3.26.0",
    "@tiptap/pm": "^3.26.0",
    "@tiptap/react": "^3.26.0",
    "@tiptap/suggestion": "^3.26.0",
    "nanoid": "^5.1.6",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@bb/plugin-build": "workspace:*",
    "@get-bb/plugin-sdk": "workspace:*",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "cross-env": "^10.1.0",
    "jsdom": "^29.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^4.1.1"
  }
}
